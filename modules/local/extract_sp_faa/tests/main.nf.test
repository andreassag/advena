nextflow_process {

    name "Test Process EXTRACT_SP_FAA"
    script "../main.nf"
    process "EXTRACT_SP_FAA"
    tag "modules"
    tag "modules_local"
    tag "extract_sp_faa"

    test("Should extract candidate SP sequences - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/tests/fixtures/detected_SP_source.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/mini.faa", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.sp_faa[0][1]).exists() }
            )
        }
    }

    test("Should extract matching SP records from proteome FASTA") {
        tag "docker"

        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file("${projectDir}/tests/fixtures/detected_SP_source.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/mini.faa", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def text = path(process.out.sp_faa[0][1]).text
            assertAll(
                { assert process.success },
                { assert text.contains("locus_tag=BSU_04800") },
                { assert text.contains("locus_tag=BSU_04860") },
                { assert text.contains("locus_tag=BSU_04870") },
                { assert text.contains("locus_tag=BSU_04940") }
            )
        }
    }

    test("Should produce empty FASTA when no SP hits exist") {
        tag "docker"

        when {
            process {
                """
                input[0] = [
                    [id: 'empty'],
                    file("${projectDir}/tests/fixtures/empty_sp.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/mini.faa", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def outFaa = path(process.out.sp_faa[0][1])
            assertAll(
                { assert process.success },
                { assert outFaa.exists() },
                { assert outFaa.text.isEmpty() }
            )
        }
    }
}
