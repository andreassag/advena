nextflow_process {

    name "Test Process MOBSUITE_INIT"
    script "../main.nf"
    process "MOBSUITE_INIT"
    tag "modules"
    tag "modules_local"
    tag "mobsuite"
    tag "mobsuite_init"

    test("Should download MOB-suite plasmid database - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.db[0]).exists() },
                { assert path("${process.out.db[0]}/status.txt").exists() }
            )
        }
    }
}
