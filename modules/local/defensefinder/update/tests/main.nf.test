nextflow_process {

    name "Test Process DEFENSEFINDER_UPDATE"
    script "../main.nf"
    process "DEFENSEFINDER_UPDATE"
    tag "modules"
    tag "modules_local"
    tag "defensefinder"
    tag "defensefinder_update"

    test("Should download DefenseFinder models - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.db[0]).exists() },
                { assert path("${process.out.db[0]}/defense-finder-models/metadata.yml").exists() }
            )
        }
    }
}
