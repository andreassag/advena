nextflow_process {

    name "Test Process EVALUATE_QC_GATE"
    script "../main.nf"
    process "EVALUATE_QC_GATE"
    tag "modules"
    tag "modules_local"
    tag "evaluate_qc_gate"

    test("Should evaluate QC gate - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = ['sample1', 'sample2']
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.summary[0]).exists() },
                { assert path(process.out.passed_samples[0]).readLines().size() == 2 }
            )
        }
    }
}
