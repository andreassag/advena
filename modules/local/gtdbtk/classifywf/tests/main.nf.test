nextflow_process {

    name "Test Process GTDBTK_CLASSIFYWF"
    script "../main.nf"
    process "GTDBTK_CLASSIFYWF"
    tag "modules"
    tag "modules_local"
    tag "gtdbtk"
    tag "gtdbtk_classifywf"

    test("Should classify genome taxonomy with GTDB-Tk - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def fa = new File("${workDir}/mini.fna")
                fa.text = ">contig1\\nACGTACGTACGTACGT\\n"
                def db = new File("${workDir}/gtdbtk_db")
                db.mkdirs()
                input[0] = [[id: 'mini'], fa.toPath()]
                input[1] = db.toPath()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.summary[0][1]).exists() },
                { assert path(process.out.summary[0][1]).text.contains("p__Bacillota") }
            )
        }
    }
}
