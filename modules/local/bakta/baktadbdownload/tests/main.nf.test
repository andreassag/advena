nextflow_process {

    name "Test Process BAKTA_BAKTADBDOWNLOAD"
    script "../main.nf"
    process "BAKTA_BAKTADBDOWNLOAD"
    tag "modules"
    tag "modules_local"
    tag "bakta"
    tag "bakta_baktadbdownload"

    test("Should download Bakta reference database - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = "light"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.db[0]).exists() },
                { assert path("${process.out.db[0]}/db-light/bakta.db").exists() }
            )
        }
    }
}
