nextflow_process {

    name "Test Process MOBSUITE_RECON"
    script "../main.nf"
    process "MOBSUITE_RECON"
    tag "modules"
    tag "modules_local"
    tag "mobsuite"
    tag "mobsuite_recon"

    test("Should classify chromosome and plasmid contigs with MOB-suite - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def fa = new File("${workDir}/mini.fna")
                fa.text = ">NC_000964.3\\nACGTACGTACGTACGT\\n"
                input[0] = [[id: 'mini'], fa.toPath()]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.contig_report[0][1]).exists() },
                { assert path(process.out.contig_report[0][1]).text.contains("molecule_type") }
            )
        }
    }
}
