nextflow_process {

    name "Test Process DEREP_AMR_CARD"
    script "../main.nf"
    process "DEREP_AMR_CARD"
    tag "modules"
    tag "modules_local"
    tag "derep_amr_card"

    test("Should dereplicate AMRFinderPlus and CARD RGI calls - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id: 'mini'],
                    file("${projectDir}/tests/fixtures/detected_ME.tsv", checkIfExists: true),
                    [],
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.derep_tsv[0][1]).exists() },
                { assert path(process.out.derep_tsv[0][1]).text.contains("canonical_symbol") }
            )
        }
    }
}
