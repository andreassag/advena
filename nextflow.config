/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    advena Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ──────────────────────────────────────────────
    // Input / output
    // ──────────────────────────────────────────────
    input = null
    outdir = "results"
    // ──────────────────────────────────────────────
    // ICEscreen
    // ──────────────────────────────────────────────
    phylum = "bacillota" // taxonomic phylum (currently only "bacillota")
    db_url = "https://github.com/andreassag/icescreen/releases/download/v1.3.3/icescreen_database.tar.gz"
    db_dir = null
    // ──────────────────────────────────────────────
    // BLAST parameters
    // ──────────────────────────────────────────────
    blastp_evalue = 0.001
    blastp_max_target_seqs = 10
    // ──────────────────────────────────────────────
    // Nextflow internals
    // ──────────────────────────────────────────────
    publish_dir_mode = "copy" // copy | symlink | move | rellink | link
    monochrome_logs = false
    help = false
    version = false
    trace_report_suffix = new java.util.Date().format("yyyy-MM-dd_HH-mm-ss")
}

// Load base resource config
includeConfig "conf/base.config"

// Execution profiles
profiles {
    debug {
        dumpHashes = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
        nextflow.enable.configProcessNamesValidation = true
    }
    // ── Container engines ──────────────────────────
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    podman {
        podman.enabled = true
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        conda.enabled = false
    }
    // ── Software environments ──────────────────────
    conda {
        conda.enabled = true
        conda.channels = ["conda-forge", "bioconda"]
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
    }
    // ── Test profiles ─────────────────────────────
    test {
        includeConfig "conf/test.config"
    }
    // ── HPC / cluster ─────────────────────────────
    hpc {
        process {
            resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
        }
    }
    slurm {
        process {
            executor = "slurm"
            resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
        }
    }
}

plugins {
    id "nf-schema@3.1.0"
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

process.shell = ["/bin/bash", "-euo", "pipefail"]

// Capture pipeline execution metadata
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name = "andreassag/advena"
    author = "Andreas Sagen"
    homePage = "https://github.com/andreassag/advena"
    description = "Nextflow pipeline for ICEscreen: detection and annotation of ICEs and IMEs in Bacillota genomes"
    mainScript = "main.nf"
    nextflowVersion = "!>=25.10.0"
    version = "1.0.0"
}

// Load module-level publishDir and ext configuration
includeConfig "conf/modules.config"
