/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    advena Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ──────────────────────────────────────────────
    // Input / output
    // ──────────────────────────────────────────────
    input = null
    outdir = "results"
    // ──────────────────────────────────────────────
    // ICEscreen
    // ──────────────────────────────────────────────
    phylum = "bacillota" // taxonomic phylum (currently only "bacillota")
    db_url = "https://github.com/andreassag/icescreen/releases/download/v1.3.3/icescreen_database.tar.gz"
    db_dir = null
    // ──────────────────────────────────────────────
    // BLAST parameters
    // ──────────────────────────────────────────────
    blastp_evalue = 0.001
    blastp_max_target_seqs = 10
    // ──────────────────────────────────────────────
    // Optional module toggles (v2.0.0)
    // ──────────────────────────────────────────────
    run_all = false
    run_qc = false
    run_taxonomy_check = false
    run_amr = false
    run_eggnog = false
    run_defense = false
    run_bgc = false
    run_mge_context = false
    run_att_sites = false
    run_cohort_cluster = false
    run_multiqc = false
    run_synteny = false
    // ──────────────────────────────────────────────
    // Reference database options
    // ──────────────────────────────────────────────
    db_cache_dir = null
    auto_download_large_dbs = false
    bakta_db = null
    bakta_db_type = "light"
    checkm2_db = null
    gtdbtk_db = null
    amrfinderplus_db = null
    card_db = null
    eggnog_db = null
    defensefinder_db = null
    mobsuite_db = null
    genomad_db = null
    antismash_db = null
    // ──────────────────────────────────────────────
    // QC, cargo, MGE context, and cohort options
    // ──────────────────────────────────────────────
    strict_qc = false
    min_completeness = 90.0
    max_contamination = 5.0
    filter_non_bacillota = false
    me_flank_bp = 0
    cargo_scope = "elements"
    amr_derep_overlap = 0.8
    rgi_include_loose = false
    eggnog_tax_scope = "1239"
    att_flank_bp = 5000
    me_ani_threshold = 95.0
    me_af_threshold = 70.0
    synteny_max_elements_per_cluster = 15
    // ──────────────────────────────────────────────
    // Nextflow internals
    // ──────────────────────────────────────────────
    publish_dir_mode = "copy" // copy | symlink | move | rellink | link
    monochrome_logs = false
    help = false
    version = false
    trace_report_suffix = new java.util.Date().format("yyyy-MM-dd_HH-mm-ss")
}

// Load base resource config
includeConfig "conf/base.config"

// Execution profiles
profiles {
    debug {
        dumpHashes = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
        nextflow.enable.configProcessNamesValidation = true
    }
    // ── Container engines ──────────────────────────
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        apptainer.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        conda.enabled = false
    }
    podman {
        podman.enabled = true
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        conda.enabled = false
    }
    // ── Software environments ──────────────────────
    conda {
        conda.enabled = true
        conda.channels = ["conda-forge", "bioconda"]
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
        podman.enabled = false
    }
    // ── Test profiles ─────────────────────────────
    test {
        includeConfig "conf/test.config"
    }
    test_full {
        includeConfig "conf/test_full.config"
    }
    // ── HPC / cluster ─────────────────────────────
    hpc {
        process {
            resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
        }
    }
    slurm {
        process {
            executor = "slurm"
            resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
        }
    }
}

plugins {
    id "nf-schema@3.1.0"
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

process.shell = ["/bin/bash", "-euo", "pipefail"]

// Capture pipeline execution metadata
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name = "andreassag/advena"
    author = "Andreas Sagen"
    homePage = "https://github.com/andreassag/advena"
    description = "Nextflow v2.0.0 mobileome discovery, cargo profiling, and comparative genomics pipeline for Bacillota ICEs and IMEs"
    mainScript = "main.nf"
    nextflowVersion = "!>=26.04.0"
    version = "2.0.0"
}

// Load module-level publishDir and ext configuration
includeConfig "conf/modules.config"
