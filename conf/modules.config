/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module-specific configuration: ext.args, ext.prefix, storeDir, publishDir
    v2.0.0 nf-core per-stage / per-tool output directory layout
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // ──────────────────────────────────────────────
    // Database download & storeDir caching
    // ──────────────────────────────────────────────
    withName: "UNTAR" {
        ext.prefix = "icescreen_database"
        storeDir = params.db_dir ?: (params.db_cache_dir ? "${params.db_cache_dir}/icescreen" : null)
    }
    withName: "BAKTA_BAKTADBDOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/bakta" : null
    }
    withName: "CHECKM2_DATABASEDOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/checkm2" : null
    }
    withName: "GTDBTK_DOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/gtdbtk" : null
    }
    withName: "AMRFINDERPLUS_UPDATE" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/amrfinderplus" : null
    }
    withName: "CARD_DOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/card" : null
    }
    withName: "EGGNOG_DOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/eggnog" : null
    }
    withName: "DEFENSEFINDER_UPDATE" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/defensefinder" : null
    }
    withName: "GENOMAD_DOWNLOAD" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/genomad" : null
    }
    withName: "MOBSUITE_INIT" {
        storeDir = params.db_cache_dir ? "${params.db_cache_dir}/mobsuite" : null
    }

    // ──────────────────────────────────────────────
    // Phase 1: Input annotation & Pre-Detection QC
    // ──────────────────────────────────────────────
    withName: "BAKTA_BAKTA" {
        publishDir = [
            path: { "${params.outdir}/bakta" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "CHECKM2_PREDICT" {
        publishDir = [
            path: { "${params.outdir}/qc/checkm2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "QUAST" {
        publishDir = [
            path: { "${params.outdir}/qc/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "GTDBTK_CLASSIFYWF" {
        publishDir = [
            path: { "${params.outdir}/qc/gtdbtk" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "EVALUATE_QC_GATE" {
        ext.args = {
            [
                "--min-completeness ${params.min_completeness}",
                "--max-contamination ${params.max_contamination}",
                params.strict_qc ? "--strict-qc" : "",
                params.filter_non_bacillota ? "--filter-non-bacillota" : ""
            ].findAll { opt -> opt }.join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            pattern: "qc_gate_summary.tsv"
        ]
    }

    // ──────────────────────────────────────────────
    // Core ICEscreen & Element Sequence Slicing
    // ──────────────────────────────────────────────
    withName: "BLAST_MAKEBLASTDB" {
        ext.args = "-dbtype prot"
        ext.prefix = { "${meta.id}" }
    }
    withName: "HMMPRESS_SP|HMMPRESS_FP" {
        ext.args = "-f"
        ext.prefix = { "${meta.id}.hmm" }
    }
    withName: "BLAST_BLASTP" {
        ext.prefix = { "${meta.id}_${meta2.id}" }
        ext.args = {
            "-task blastp -evalue ${params.blastp_evalue} -max_target_seqs ${params.blastp_max_target_seqs} -outfmt '6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qlen slen'"
        }
    }
    withName: "HMMSCAN_SP|HMMSCAN_FP" {
        ext.prefix = { "${meta.id}" }
    }
    withName: "REANNOT_SP" {
        publishDir = [
            path: { "${params.outdir}/icescreen/${meta.id}/detected_signature_proteins" },
            mode: params.publish_dir_mode,
            pattern: "*_detected_SP.tsv"
        ]
    }
    withName: "DETECT_ME" {
        publishDir = [
            path: { "${params.outdir}/icescreen/${meta.id}/detected_mobile_elements" },
            mode: params.publish_dir_mode,
            pattern: "*_{detected_ME.tsv,detected_ME.summary,detected_SP_withMEIds.tsv}"
        ]
    }
    withName: "CREATE_ANNOTATIONS" {
        publishDir = [
            path: { "${params.outdir}/icescreen/${meta.id}/detected_mobile_elements/standard_genome_annotation_formats" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "PACKAGE_RESULTS" {
        publishDir = [
            path: { "${params.outdir}/icescreen/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "EXTRACT_ME_SEQUENCES" {
        ext.args = { "--flank-bp ${params.me_flank_bp} --scope ${params.cargo_scope}" }
        publishDir = [
            path: { "${params.outdir}/icescreen/${meta.id}/me_sequences" },
            mode: params.publish_dir_mode,
            pattern: "{*_ME_regions.bed,*_ME_regions.fna.gz,*_ME_cds.faa.gz,*_ME_cds.gff3.gz,*_ME_cds_manifest.tsv,slices/*.gbk.gz}"
        ]
    }

    // ──────────────────────────────────────────────
    // Phase 2: Mobile Cargo & Functional Profiling
    // ──────────────────────────────────────────────
    withName: "AMRFINDERPLUS_RUN" {
        ext.args = "--plus"
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/amrfinderplus" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "RGI_MAIN" {
        ext.args = { params.rgi_include_loose ? "--include_loose" : "" }
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/card_rgi" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "DEREP_AMR_CARD" {
        ext.args = {
            [
                "--min-overlap ${params.amr_derep_overlap}",
                params.rgi_include_loose ? "--include-loose" : ""
            ].findAll { opt -> opt }.join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/amr_dereplicated" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "EGGNOGMAPPER" {
        ext.args = { "--tax_scope ${params.eggnog_tax_scope}" }
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/eggnog" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "PARSE_EGGNOG_OGS" {
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/eggnog" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "DEFENSEFINDER_RUN" {
        ext.args = "--preserve-raw"
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/defensefinder" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "ANTISMASH_ANTISMASHLITE" {
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/antismash" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^${meta.id}/", "") }
        ]
    }
    withName: "INTERSECT_BGC_ME" {
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}/antismash" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "MERGE_CARGO_ANNOTATIONS" {
        publishDir = [
            path: { "${params.outdir}/cargo/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ──────────────────────────────────────────────
    // Phase 3: Complementary MGE Context & attL/attR
    // ──────────────────────────────────────────────
    withName: "MOBSUITE_RECON" {
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}/mobsuite" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^${meta.id}/", "") }
        ]
    }
    withName: "GENOMAD_ENDTOEND" {
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}/genomad" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^${meta.id}/", "") }
        ]
    }
    withName: "ISESCAN" {
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}/isescan" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^${meta.id}/", "") }
        ]
    }
    withName: "INTEGRONFINDER" {
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}/integronfinder" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^${meta.id}/", "") }
        ]
    }
    withName: "DETECT_ATT_SITES" {
        ext.args = { "--flank-bp ${params.att_flank_bp}" }
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}/att_sites" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "CONTEXTUALIZE_ME" {
        publishDir = [
            path: { "${params.outdir}/mge_context/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // ──────────────────────────────────────────────
    // Phase 4: Cohort Comparative Genomics & Reporting
    // ──────────────────────────────────────────────
    withName: "SKANI_TRIANGLE" {
        publishDir = [
            path: { "${params.outdir}/cohort/skani" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "MMSEQS_EASYCLUSTER" {
        publishDir = [
            path: { "${params.outdir}/cohort/mmseqs" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "CLUSTER_MES" {
        ext.args = { "--ani-threshold ${params.me_ani_threshold} --af-threshold ${params.me_af_threshold}" }
        publishDir = [
            path: { "${params.outdir}/cohort" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "COHORT_SUMMARY" {
        publishDir = [
            path: { "${params.outdir}/cohort" },
            mode: params.publish_dir_mode,
            pattern: "{cohort_me_cargo_summary.tsv,og_presence_absence.tsv}"
        ]
    }
    withName: "MULTIQC" {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
    withName: "PYGENOMEVIZ_SYNTENY" {
        ext.args = { "--max-elements ${params.synteny_max_elements_per_cluster}" }
        publishDir = [
            path: { "${params.outdir}/cohort/synteny" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.replaceFirst("^synteny_plots/", "") }
        ]
    }
}
