/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full offline integration test profile using miniature fixture databases
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input = "${projectDir}/tests/fixtures/samplesheet_full.csv"
    outdir = "results_full"
    phylum = "bacillota"
    db_url = "${projectDir}/tests/fixtures/mini_db.tar.gz"

    // Enable cargo, att-site, cohort clustering, MultiQC, and synteny stages
    run_amr = true
    run_eggnog = true
    run_defense = true
    run_att_sites = true
    run_cohort_cluster = true
    run_multiqc = true
    run_synteny = true

    // Miniature offline reference fixture DBs
    amrfinderplus_db = "${projectDir}/tests/fixtures/dbs/mini_amrfinder_db"
    card_db = "${projectDir}/tests/fixtures/dbs/mini_card_db"
    eggnog_db = "${projectDir}/tests/fixtures/dbs/mini_eggnog_db"
    defensefinder_db = "${projectDir}/tests/fixtures/dbs/mini_defensefinder_db"
}

process {
    resourceLimits = [
        cpus: 2,
        memory: 6.GB,
        time: 6.h
    ]
}
